# --- LLM (free options) ---
# Groq (default): https://console.groq.com/keys
LLM_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=
# Specialists use a smaller model; on Groq each model has its own daily quota
SPECIALIST_LLM_MODEL=groq/openai/gpt-oss-20b
# hierarchical (manager delegates) | sequential (no manager, ~half the tokens)
CREW_PROCESS=hierarchical
# When a Groq model hits its daily quota, switch to the next of these
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Gemini free tier fallback: set LLM_MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=

# --- Search (set one) ---
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Other free-tier APIs ---
OPENWEATHER_API_KEY=
ORS_API_KEY=
# Optional: without it the keyless open.er-api.com endpoint is used
EXCHANGERATE_API_KEY=
# Optional: without it flights fall back to search-based estimates
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Tuning ---
MAX_BUDGET_ITERATIONS=3
MAX_RPM=20
CACHE_TTL_HOURS=24
API_URL=http://localhost:8000
